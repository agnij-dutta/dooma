# ---------------------------------------------------------------------------
# VERDICT Escrow — deployment environment
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. NEVER commit a real private key.
# ---------------------------------------------------------------------------

# Private key that pays for deployment gas and becomes the deployer/msg.sender.
# Needs testnet OG (deploy gas is small — well under 0.1 OG). A throwaway/
# dedicated deployer key is recommended; it has no special powers after deploy.
# (Placeholder below is Anvil's well-known test key #0 — DO NOT use on testnet
# with real funds; replace it.)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bcb478cbed5efcae784d7bf4f2ff80b

# The ONLY address allowed to call resolve() (write verdicts + trigger payout).
# This MUST equal the address of the VERDICT backend signer that will call
# resolve() in production. It is IMMUTABLE — set wrong and you must redeploy.
RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional. Address that collects the protocol fee on each resolve().
# IMMUTABLE. If omitted, the deploy script defaults this to the deployer.
# FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Protocol fee in basis points. 250 = 2.5%. Hard cap is 1000 (10%).
# Use 0 for a no-fee deployment (e.g. demo).
FEE_BPS=250

# 0G Galileo TESTNET RPC. chainId 16602, native currency OG.
RPC_URL=https://evmrpc-testnet.0g.ai

# Chain id (informational; forge derives it from the RPC). Galileo testnet.
CHAIN_ID=16602

# 0G block explorer base (Blockscout-style). Used by the verify command.
# No Etherscan API key is required for Blockscout verification.
EXPLORER_API_URL=https://chainscan-galileo.0g.ai/api
