# Copy to .env and fill in. NEVER commit .env.
# A funded 0G testnet (Galileo) private key — no 0x prefix is also fine, we normalize.
# Get testnet OG from the 0G faucet, then this wallet needs a small balance for the ledger.
PRIVATE_KEY=

# 0G testnet RPC. Override if docs say otherwise.
RPC_URL=https://evmrpc-testnet.0g.ai

# Optional: pin a specific provider address to test. Leave blank to auto-pick the first verifiable one.
PROVIDER_ADDRESS=

# How much OG to fund the ledger with on first run (string, in OG).
LEDGER_FUND_OG=0.1
