# Server-side wallet for 0G broker attestation reads.
# verifyService() / getSignerRaDownloadLink() need NO funds — a throwaway key
# (or even a random wallet) works. The spike's throwaway key is fine here.
# If unset, the attestation route generates a random ephemeral wallet per call.
ATTESTATION_PRIVATE_KEY=0x865d762f4cfcd272e3f81b2bba218ff9d465f2fd0d371fb786131c875c199806

# 0G Galileo testnet RPC + chain.
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Default live TEE provider (confirmed by the spike). model: qwen/qwen2.5-omni-7b
NEXT_PUBLIC_DEFAULT_PROVIDER=0xa48f01287233509FD694a22Bf840225062E67836

# WalletConnect project id for RainbowKit (optional for local injected-wallet dev).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed Escrow address (none yet — blocked on funding). Leave blank for MVP.
NEXT_PUBLIC_ESCROW_ADDRESS=

# ----------------------------------------------------------------------------
# CHEAP REAL AI RULINGS — no 3 OG ledger needed.
# The verified 0G Compute path needs a funded ledger (3 OG, contract-enforced,
# refundable). For real, intelligent verdicts WITHOUT it, set an OpenAI-compatible
# key here — costs ~cents, or free on Groq / OpenRouter free tiers. Unset = the
# app uses a free offline mock ruling. (This demo path carries NO TEE attestation
# over its output — the AttestationPanel proves the 0G serving stack separately.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
